<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GitHubTray_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GitHubTray_App"
    xmlns:controls="using:GitHubTray_App.Controls"
    xmlns:vm="using:GitHubTray_App.ViewModels"
    Background="{ThemeResource SubtleFillColorTransparentBrush}">
    <Page.Resources>
        <Style x:Key="MenuActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <DataTemplate x:Key="DashboardRowTemplate" x:DataType="vm:DashboardRow">
            <Border BorderThickness="0,0,0,1" Padding="0,10"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid ColumnSpacing="8" RowSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Viewbox Width="14" Height="14" VerticalAlignment="Top" Margin="0,3,0,0"
                             AutomationProperties.AccessibilityView="Raw">
                        <SymbolIcon Symbol="{x:Bind Icon, Mode=OneTime}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Viewbox>
                    <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind Heading, Mode=OneTime}"
                               FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind Heading, Mode=OneTime}" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{x:Bind SecondaryText, Mode=OneTime}"
                               Visibility="{x:Bind local:MainPage.Visible(HasSecondaryText), Mode=OneTime}"
                               TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               ToolTipService.ToolTip="{x:Bind SecondaryText, Mode=OneTime}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind Detail, Mode=OneTime}"
                               Visibility="{x:Bind local:MainPage.Visible(HasDetail), Mode=OneTime}"
                               TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               ToolTipService.ToolTip="{x:Bind Detail, Mode=OneTime}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind RelativeTimestamp, Mode=OneWay}"
                               VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                               ToolTipService.ToolTip="{x:Bind Timestamp, Mode=OneTime}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="PullRequestRowTemplate" x:DataType="vm:DashboardRow">
            <controls:PullRequestCard Data="{x:Bind PullRequest, Mode=OneWay}"
                                      Loaded="PullRequestCard_Loaded" Unloaded="PullRequestCard_Unloaded" />
        </DataTemplate>
        <controls:PullRequestTemplateSelector x:Key="DashboardTemplateSelector"
                                              RowTemplate="{StaticResource DashboardRowTemplate}"
                                              PullRequestTemplate="{StaticResource PullRequestRowTemplate}" />
    </Page.Resources>
    <Grid Padding="8" RowSpacing="0">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="RefreshAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12" Margin="8,4,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.AccountHandle, Mode=OneWay}"
                           Style="{StaticResource BodyStrongTextBlockStyle}" FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="CurrentAccount" AutomationProperties.HeadingLevel="Level1"
                           ToolTipService.ToolTip="{x:Bind ViewModel.AccountDescription, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.AccountDisplayName, Mode=OneWay}" MinHeight="16"
                           TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="CurrentAccountName"
                           ToolTipService.ToolTip="{x:Bind ViewModel.AccountDisplayName, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{x:Bind ContributionGraph.ViewModel.Summary, Mode=OneWay, FallbackValue='Not loaded'}"
                       AutomationProperties.AutomationId="ContributionSummary"
                       AutomationProperties.Name="{x:Bind ContributionGraph.ViewModel.AccessibleSummary, Mode=OneWay, FallbackValue='Contribution calendar'}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Spacing lives on each notification so the row collapses to nothing when all are closed. -->
        <StackPanel Grid.Row="1" Margin="8,0">
            <InfoBar IsOpen="{x:Bind ViewModel.HasTrayError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8"
                     Visibility="{x:Bind local:MainPage.Visible(ViewModel.HasTrayError), Mode=OneWay}"
                     Severity="Error" Title="Notification area unavailable"
                     Message="{x:Bind ViewModel.TrayError, Mode=OneWay}"
                     AutomationProperties.AutomationId="TrayErrorInfoBar">
                <InfoBar.ActionButton>
                    <Button Content="Retry tray" Click="RetryTrayButton_Click"
                            AutomationProperties.AutomationId="RetryTrayButton" AutomationProperties.Name="Retry notification area icon" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar IsOpen="{x:Bind ViewModel.HasRefreshError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8"
                     Visibility="{x:Bind local:MainPage.Visible(ViewModel.HasRefreshError), Mode=OneWay}"
                     Severity="Warning" Title="Account check failed"
                     Message="{x:Bind ViewModel.RefreshError, Mode=OneWay}"
                     AutomationProperties.AutomationId="RefreshErrorInfoBar" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasSettingsWarning, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8"
                     Visibility="{x:Bind local:MainPage.Visible(ViewModel.HasSettingsWarning), Mode=OneWay}"
                     Severity="Warning" Title="Settings need attention"
                     Message="{x:Bind ViewModel.SettingsWarning, Mode=OneWay}"
                     AutomationProperties.AutomationId="SettingsWarningInfoBar" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasActionError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8"
                     Visibility="{x:Bind local:MainPage.Visible(ViewModel.HasActionError), Mode=OneWay}"
                     Severity="Error" Title="Action unavailable"
                     Message="{x:Bind ViewModel.ActionError, Mode=OneWay}"
                     AutomationProperties.AutomationId="ActionErrorInfoBar" />
        </StackPanel>

        <Grid Grid.Row="2" RowSpacing="0"
              Visibility="{x:Bind local:MainPage.Hidden(ViewModel.IsSettingsOpen), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="8">
                <controls:ContributionHeatmap x:Name="ContributionGraph" Margin="8,0"
                                              Calendar="{x:Bind ViewModel.VisibleContributionCalendar, Mode=OneWay}"
                                              Status="{x:Bind ViewModel.ContributionStatus, Mode=OneWay}"
                                              HasError="{x:Bind local:MainPage.HasError(ViewModel.Contributions.Error), Mode=OneWay}"
                                              IsLoading="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"
                                              IsActive="{x:Bind local:MainPage.Not(ViewModel.IsSettingsOpen), Mode=OneWay}"
                                              CellSizePreset="{x:Bind ViewModel.ContributionCellSize, Mode=OneWay}"
                                              AutomationProperties.AutomationId="ContributionGraph" />
                <controls:CopilotUsageCard Margin="8,0"
                                           ViewModel="{x:Bind ViewModel.CopilotDisplay, Mode=OneWay}"
                                           AutomationProperties.AutomationId="CopilotUsage"
                                           ToolTipService.ToolTip="Account-wide Copilot quota for the current gh account, not CLI session usage." />
            </StackPanel>
            <SelectorBar x:Name="ModeSelector" Grid.Row="1" Margin="0,12,0,0" SelectionChanged="ModeSelector_SelectionChanged"
                         AutomationProperties.AutomationId="DashboardModes" AutomationProperties.Name="Dashboard section">
                <SelectorBarItem Text="Activity" Tag="0"
                                 AutomationProperties.AutomationId="ActivityTab" AutomationProperties.Name="Recent GitHub activity" />
                <SelectorBarItem Text="My PRs" Tag="1"
                                 AutomationProperties.AutomationId="PullRequestsTab" AutomationProperties.Name="My authored pull requests" />
                <SelectorBarItem Text="Reviews" Tag="2"
                                 AutomationProperties.AutomationId="ReviewsTab" AutomationProperties.Name="Review requests" />
                <SelectorBarItem Text="Repos" Tag="3"
                                 AutomationProperties.AutomationId="RepositoriesTab" AutomationProperties.Name="Repositories" />
            </SelectorBar>
            <Grid Grid.Row="2" ColumnSpacing="8" Margin="8,8,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.SelectedSection.Title, Mode=OneWay, FallbackValue='Activity'}"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level2"
                           AutomationProperties.AutomationId="SectionHeading" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedSection.UpdatedLabel, Mode=OneWay, FallbackValue='Not refreshed yet'}"
                           Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           ToolTipService.ToolTip="{x:Bind ViewModel.SelectedSection.UpdatedLabel, Mode=OneWay, FallbackValue='Not refreshed yet'}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="SectionLastUpdated" />
            </Grid>
            <InfoBar Grid.Row="3" Margin="8,8,8,0"
                     IsOpen="{x:Bind ViewModel.SelectedSection.HasError, Mode=OneWay, FallbackValue=False}"
                     IsClosable="False" Severity="Warning" Title="Section refresh failed · data may be stale"
                     Message="{x:Bind ViewModel.SelectedSection.Error, Mode=OneWay, FallbackValue=''}"
                     AutomationProperties.AutomationId="SectionErrorInfoBar" />
            <ListView x:Name="DashboardList" Grid.Row="4" Margin="0,4,0,0"
                      ItemsSource="{x:Bind ViewModel.SelectedSection.Items, Mode=OneWay, FallbackValue={x:Null}}"
                      Visibility="{x:Bind local:MainPage.Visible(ViewModel.HasDisplayableData), Mode=OneWay}"
                      SelectionMode="Single" IsItemClickEnabled="True" ItemClick="DashboardList_ItemClick"
                      ItemTemplateSelector="{StaticResource DashboardTemplateSelector}"
                      ContainerContentChanging="DashboardList_ContainerContentChanging"
                      AutomationProperties.AutomationId="DashboardList"
                      AutomationProperties.Name="{x:Bind ViewModel.SelectedSection.Title, Mode=OneWay, FallbackValue='Activity'}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
            <ScrollViewer Grid.Row="4" Margin="0,4,0,0"
                          Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsEmptyVisible), Mode=OneWay}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,24" Spacing="8" HorizontalAlignment="Stretch">
                    <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               AutomationProperties.AutomationId="EmptyStateTitle" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.AutomationId="EmptyStateMessage" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsSettingsOpen), Mode=OneWay}">
            <StackPanel Spacing="16" Padding="8,0,8,8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Click="BackButton_Click"
                            AutomationProperties.AutomationId="SettingsBackButton" AutomationProperties.Name="Back to dashboard"
                            ToolTipService.ToolTip="Back to dashboard">
                        <SymbolIcon Symbol="Back" />
                    </Button>
                    <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                </Grid>
                <TextBox x:Name="RefreshIntervalBox" Header="Refresh interval (minutes)"
                         Text="{x:Bind ViewModel.RefreshMinutesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{x:Bind ViewModel.IsSettingsLoaded, Mode=OneWay}" InputScope="Number" MaxLength="2"
                         AutomationProperties.AutomationId="RefreshIntervalTextBox"
                         AutomationProperties.Name="Refresh interval in minutes"
                         AutomationProperties.HelpText="Enter a whole number from 1 through 60. Default is 5." />
                <TextBlock Text="1–60 minutes. Default: 5. Refresh continues while the panel is hidden. Eligible dashboard data is cached separately from settings."
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="Save interval" Command="{x:Bind ViewModel.SaveSettingsCommand, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.AutomationId="SaveSettingsButton" AutomationProperties.Name="Save refresh interval" />
                <InfoBar IsOpen="{x:Bind ViewModel.HasSettingsStatus, Mode=OneWay}" IsClosable="False"
                         Severity="Success" Title="Settings saved"
                         Message="{x:Bind ViewModel.SettingsStatus, Mode=OneWay}"
                         AutomationProperties.AutomationId="SettingsSavedInfoBar" />
                <ComboBox Header="Contribution cell size" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.ContributionCellSizes, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.ContributionCellSize, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.IsSettingsLoaded, Mode=OneWay}"
                          AutomationProperties.AutomationId="ContributionCellSizeSelector"
                          AutomationProperties.Name="Contribution cell size" />
                <TextBlock Text="Small fits all 12 months. Medium and Large keep larger cells and scroll horizontally for older activity. Applies and saves automatically."
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="GitHub CLI account" Style="{StaticResource BodyStrongTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="{x:Bind ViewModel.AccountDescription, Mode=OneWay}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="SettingsAccountDescription" />
                <TextBlock Text="GitHub Tray uses your existing gh sign-in for github.com. It never opens sign-in, reads a token, or stores credentials."
                           TextWrapping="Wrap" />
                <TextBlock Text="If sign-in is needed, run these commands yourself in a terminal, then return here and choose Refresh:"
                           TextWrapping="Wrap" />
                <TextBlock Text="gh auth login --hostname github.com&#x0a;gh auth status --hostname github.com"
                           IsTextSelectionEnabled="True" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="GitHubCliInstructions" />
                <TextBlock Text="GitHub CLI chooses the account. GH_TOKEN, then GITHUB_TOKEN, can override stored credentials; GH_CONFIG_DIR can change which stored CLI configuration is used. Environment changes may require quitting and reopening GitHub Tray. To change a stored account, use gh auth switch --hostname github.com in a terminal. Every refresh verifies the current account again."
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Cached dashboard data" Style="{StaticResource BodyStrongTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="Clear saved dashboard data for every cached GitHub account on this device. This preserves GitHub CLI authentication and all preferences. The dashboard currently on screen may remain visible, but it will not be reused; the next refresh fetches every section and can save fresh data again."
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="ClearCachedDataDescription" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Clear cached data" Click="ClearCachedDataButton_Click"
                            IsEnabled="{x:Bind ViewModel.CanClearCachedData, Mode=OneWay}"
                            AutomationProperties.AutomationId="ClearCachedDataButton"
                            AutomationProperties.Name="Clear cached dashboard data for all accounts"
                            AutomationProperties.HelpText="Preserves GitHub CLI authentication and settings. The next refresh fetches all dashboard sections." />
                    <ProgressRing Width="20" Height="20"
                                  IsActive="{x:Bind ViewModel.IsClearingCachedData, Mode=OneWay}"
                                  Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsClearingCachedData), Mode=OneWay}"
                                  AutomationProperties.AutomationId="ClearCachedDataProgress"
                                  AutomationProperties.Name="Clearing cached dashboard data" />
                </StackPanel>
                <InfoBar IsOpen="{x:Bind ViewModel.HasCacheClearStatus, Mode=OneWay}" IsClosable="False"
                         Severity="Success" Title="Cached data cleared"
                         Message="{x:Bind ViewModel.CacheClearStatus, Mode=OneWay}"
                         AutomationProperties.AutomationId="CacheClearSuccessInfoBar" />
                <InfoBar IsOpen="{x:Bind ViewModel.HasCacheClearWarning, Mode=OneWay}" IsClosable="False"
                         Severity="Warning" Title="Cached data was not fully cleared"
                         Message="{x:Bind ViewModel.CacheClearWarning, Mode=OneWay}"
                         AutomationProperties.AutomationId="CacheClearWarningInfoBar" />
                <TextBlock Text="Closing or pressing Escape hides this panel. Use the notification-area menu to open, refresh, view settings, or quit. GitHub Tray does not change Windows startup settings."
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SettingsButton" HorizontalAlignment="Stretch"
                        Style="{StaticResource MenuActionButtonStyle}" Click="SettingsButton_Click"
                        AutomationProperties.AutomationId="SettingsButton" AutomationProperties.Name="Preferences"
                        ToolTipService.ToolTip="Preferences">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                        <TextBlock Text="Preferences…" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource MenuActionButtonStyle}"
                        Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}"
                        AutomationProperties.AutomationId="RefreshButton" AutomationProperties.Name="Refresh all sections"
                        ToolTipService.ToolTip="Refresh all sections (F5 or Ctrl+R)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Content="Quit" Style="{StaticResource MenuActionButtonStyle}" Click="QuitButton_Click"
                        AutomationProperties.AutomationId="QuitButton" AutomationProperties.Name="Quit GitHub Tray" />
            </Grid>
        </Border>
    </Grid>
</Page>
