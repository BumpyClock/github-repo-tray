<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GitHubTray_App.Controls.PullRequestCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GitHubTray_App.Controls"
    xmlns:vm="using:GitHubTray_App.ViewModels"
    xmlns:core="using:GitHubTray.Core"
    HorizontalContentAlignment="Stretch" IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="PullRequestOpenForegroundBrush" ResourceKey="SystemFillColorSuccessBrush" />
                    <StaticResource x:Key="PullRequestClosedForegroundBrush" ResourceKey="SystemFillColorCriticalBrush" />
                    <StaticResource x:Key="PullRequestDraftForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
                    <SolidColorBrush x:Key="PullRequestMergedForegroundBrush" Color="#6F42C1" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="PullRequestOpenForegroundBrush" ResourceKey="SystemFillColorSuccessBrush" />
                    <StaticResource x:Key="PullRequestClosedForegroundBrush" ResourceKey="SystemFillColorCriticalBrush" />
                    <StaticResource x:Key="PullRequestDraftForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
                    <SolidColorBrush x:Key="PullRequestMergedForegroundBrush" Color="#D2B7FF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="PullRequestOpenForegroundBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PullRequestClosedForegroundBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PullRequestDraftForegroundBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PullRequestMergedForegroundBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="0,0,0,1" Padding="0,10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PullRequestStates">
                <VisualState x:Name="Open">
                    <VisualState.Setters>
                        <Setter Target="StateIcon.Foreground" Value="{ThemeResource PullRequestOpenForegroundBrush}" />
                        <Setter Target="StateText.Foreground" Value="{ThemeResource PullRequestOpenForegroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Draft">
                    <VisualState.Setters>
                        <Setter Target="StateIcon.Foreground" Value="{ThemeResource PullRequestDraftForegroundBrush}" />
                        <Setter Target="StateText.Foreground" Value="{ThemeResource PullRequestDraftForegroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Closed">
                    <VisualState.Setters>
                        <Setter Target="StateIcon.Foreground" Value="{ThemeResource PullRequestClosedForegroundBrush}" />
                        <Setter Target="StateText.Foreground" Value="{ThemeResource PullRequestClosedForegroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Merged">
                    <VisualState.Setters>
                        <Setter Target="StateIcon.Foreground" Value="{ThemeResource PullRequestMergedForegroundBrush}" />
                        <Setter Target="StateText.Foreground" Value="{ThemeResource PullRequestMergedForegroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <PersonPicture x:Name="AuthorPicture" Width="24" Height="24" VerticalAlignment="Top"
                           DisplayName="{x:Bind Data.AuthorLogin, Mode=OneWay}"
                           Initials="{x:Bind Data.AuthorInitials, Mode=OneWay}"
                           AutomationProperties.AccessibilityView="Raw" />
            <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{x:Bind Data.Title, Mode=OneWay}"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                       ToolTipService.ToolTip="{x:Bind Data.Title, Mode=OneWay}" />
            <TextBlock Text="{x:Bind Data.Repository, Mode=OneWay}"
                       Visibility="{x:Bind local:PullRequestCard.Visible(ShowRepository), Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       ToolTipService.ToolTip="{x:Bind Data.Repository, Mode=OneWay}" />
            <TextBlock Text="{x:Bind Data.Metadata, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       ToolTipService.ToolTip="{x:Bind Data.MetadataToolTip, Mode=OneWay}" />
            <TextBlock Text="{x:Bind Data.ActivitySummary, Mode=OneWay}"
                       Visibility="{x:Bind local:PullRequestCard.Visible(Data.HasActivity), Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       MaxLines="2" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       ToolTipService.ToolTip="{x:Bind Data.ActivityToolTip, Mode=OneWay}" />
            <TextBlock Text="{x:Bind Data.Branches, Mode=OneWay}"
                       FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       ToolTipService.ToolTip="{x:Bind Data.Branches, Mode=OneWay}" />
                <Border Padding="6,2" CornerRadius="{ThemeResource ControlCornerRadius}" HorizontalAlignment="Left"
                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                        Visibility="{x:Bind local:PullRequestCard.Visible(Data.HasReviewDecision), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Data.ReviewDecisionText, Mode=OneWay}">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind Data.ReviewDecisionGlyph, Mode=OneWay}" FontSize="12"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Data.ReviewDecisionText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            <Grid ColumnSpacing="4"
                  Visibility="{x:Bind local:PullRequestCard.Visible(Data.HasLabels), Mode=OneWay}"
                  ToolTipService.ToolTip="{x:Bind Data.LabelsToolTip, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{x:Bind Data.Labels, Mode=OneWay}" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:PullRequestLabel">
                            <Border Padding="6,2" Margin="0,0,4,0" MaxWidth="76"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                    ToolTipService.ToolTip="{x:Bind Name, Mode=OneTime}">
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Color is decorative only. Names always use platform text brushes. -->
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                             Fill="{x:Bind local:PullRequestCard.LabelDotBrush(Color), Mode=OneTime}"
                                             AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneTime}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Grid.Column="1" Padding="6,2" MaxWidth="64"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                        Visibility="{x:Bind local:PullRequestCard.Visible(Data.HasAdditionalLabels), Mode=OneWay}">
                    <TextBlock Text="{x:Bind Data.AdditionalLabelsText, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
            </Grid>
            <Grid ColumnSpacing="6" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="6,3" CornerRadius="{ThemeResource ControlCornerRadius}" VerticalAlignment="Center"
                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                        ToolTipService.ToolTip="{x:Bind Data.StateDescription, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon x:Name="StateIcon" Glyph="{x:Bind Data.StateGlyph, Mode=OneWay}" FontSize="12"
                                  Foreground="{ThemeResource PullRequestDraftForegroundBrush}"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="StateText" Text="{x:Bind Data.StateLabel, Mode=OneWay}"
                                   Foreground="{ThemeResource PullRequestDraftForegroundBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
            <Button x:Name="ChecksButton" Grid.Column="1"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="32"
                    Tapped="ChecksButton_Tapped" KeyDown="ChecksButton_KeyDown"
                    AutomationProperties.AutomationId="{x:Bind Data.ChecksButtonAutomationId, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind Data.ChecksAccessibleName, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Data.FreshnessDescription, Mode=OneWay}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind Data.ChecksGlyph, Mode=OneWay}" FontSize="14"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Data.ChecksSummary, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10"
                              AutomationProperties.AccessibilityView="Raw" />
                </Grid>
                <Button.Flyout>
                    <Flyout x:Name="ChecksFlyout" Placement="Bottom" Opening="ChecksFlyout_Opening" Closed="ChecksFlyout_Closed">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="MaxWidth" Value="372" />
                                <Setter Property="MaxHeight" Value="480" />
                                <Setter Property="Padding" Value="12" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <Grid Width="312" MaxHeight="440" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind Data.ChecksSummary, Mode=OneWay}" TextWrapping="Wrap"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           AutomationProperties.HeadingLevel="Level3" />
                                <TextBlock Text="{x:Bind Data.HeadCommitLabel, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="12"
                                           ToolTipService.ToolTip="{x:Bind Data.HeadCommitToolTip, Mode=OneWay}" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          AutomationProperties.Name="Individual pull request checks">
                              <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind Data.FreshnessDescription, Mode=OneWay}" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Data.CheckCountLabel, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Data.ChecksExplanation, Mode=OneWay}" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Data.EmptyChecksMessage, Mode=OneWay}" TextWrapping="Wrap"
                                           Visibility="{x:Bind local:PullRequestCard.Hidden(Data.HasChecks), Mode=OneWay}" />
                                <ItemsControl ItemsSource="{x:Bind Data.Checks, Mode=OneWay}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PullRequestCheckViewModel">
                                            <Border Padding="0,8" BorderThickness="0,1,0,0"
                                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                                <Grid ColumnSpacing="8" RowSpacing="2"
                                                      AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneTime}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <FontIcon Glyph="{x:Bind Glyph, Mode=OneTime}" FontSize="14"
                                                              VerticalAlignment="Top" Margin="0,3,0,0"
                                                              AutomationProperties.AccessibilityView="Raw" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneTime}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind State, Mode=OneTime}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </ScrollViewer>
                            <Button Grid.Row="2" Click="OpenChecks_Click"
                                    HorizontalAlignment="Stretch" MinHeight="32"
                                    IsEnabled="{x:Bind Data.CanOpenChecks, Mode=OneWay}"
                                    AutomationProperties.AutomationId="{x:Bind Data.OpenChecksAutomationId, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind Data.OpenChecksAccessibleName, Mode=OneWay}">
                                <TextBlock Text="Open checks on GitHub" TextWrapping="Wrap" />
                            </Button>
                        </Grid>
                    </Flyout>
                </Button.Flyout>
            </Button>
            </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
