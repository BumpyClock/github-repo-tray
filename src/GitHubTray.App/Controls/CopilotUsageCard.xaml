<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GitHubTray_App.Controls.CopilotUsageCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GitHubTray_App"
    xmlns:vm="using:GitHubTray_App.ViewModels">
    <Border BorderThickness="0,1,0,0" Padding="0,12,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
    <StackPanel Spacing="8">
        <ItemsControl ItemsSource="{x:Bind ViewModel.Quotas, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="12" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CopilotQuotaViewModel">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Plan}"
                                       AutomationProperties.AutomationId="CopilotPlan"
                                       Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind UsedPercent}"
                                     Visibility="{x:Bind local:MainPage.Visible(HasMeter)}"
                                     AutomationProperties.AutomationId="{x:Bind MeterAutomationId}"
                                     AutomationProperties.Name="{x:Bind AccessibleName}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ValueLabel}" Style="{StaticResource CaptionTextBlockStyle}"
                                       AutomationProperties.AutomationId="{x:Bind ValueAutomationId}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ResetLabel}"
                                       AutomationProperties.AutomationId="CopilotReset"
                                       Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right"
                                       Visibility="{x:Bind local:MainPage.Visible(HasMeter)}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap"
                   Visibility="{x:Bind local:MainPage.Visible(ViewModel.HasStatus), Mode=OneWay}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   AutomationProperties.AutomationId="CopilotUsageStatus"
                   AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    </Border>
</UserControl>
