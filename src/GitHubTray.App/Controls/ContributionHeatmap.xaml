<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GitHubTray_App.Controls.ContributionHeatmap"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GitHubTray_App.Controls"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    AutomationProperties.Name="{x:Bind ViewModel.AccessibleSummary, Mode=OneWay}"
    AutomationProperties.HelpText="Use Up and Down for the previous or next day, Left and Right for the previous or next week, Home for the first day, and End for the last day. Counts and dates are shown below the chart.">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ContributionLevel0Brush" Color="#E7ECE8" />
                    <SolidColorBrush x:Key="ContributionLevel1Brush" Color="#BCDFC2" />
                    <SolidColorBrush x:Key="ContributionLevel2Brush" Color="#75BE89" />
                    <SolidColorBrush x:Key="ContributionLevel3Brush" Color="#388654" />
                    <SolidColorBrush x:Key="ContributionLevel4Brush" Color="#185C37" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ContributionLevel0Brush" Color="#24332B" />
                    <SolidColorBrush x:Key="ContributionLevel1Brush" Color="#244D34" />
                    <SolidColorBrush x:Key="ContributionLevel2Brush" Color="#327448" />
                    <SolidColorBrush x:Key="ContributionLevel3Brush" Color="#4B9E61" />
                    <SolidColorBrush x:Key="ContributionLevel4Brush" Color="#8CCF99" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ContributionLevel0Brush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ContributionLevel1Brush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="ContributionLevel2Brush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="ContributionLevel3Brush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ContributionLevel4Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="ContributionCellStyle" TargetType="local:ContributionDayCell">
                <Setter Property="Margin" Value="1" />
                <Setter Property="BorderThickness" Value="0.5" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:ContributionDayCell">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="1" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ContributionLevel0Style" TargetType="local:ContributionDayCell"
                   BasedOn="{StaticResource ContributionCellStyle}">
                <Setter Property="Background" Value="{ThemeResource ContributionLevel0Brush}" />
            </Style>
            <Style x:Key="ContributionLevel1Style" TargetType="local:ContributionDayCell"
                   BasedOn="{StaticResource ContributionCellStyle}">
                <Setter Property="Background" Value="{ThemeResource ContributionLevel1Brush}" />
            </Style>
            <Style x:Key="ContributionLevel2Style" TargetType="local:ContributionDayCell"
                   BasedOn="{StaticResource ContributionCellStyle}">
                <Setter Property="Background" Value="{ThemeResource ContributionLevel2Brush}" />
            </Style>
            <Style x:Key="ContributionLevel3Style" TargetType="local:ContributionDayCell"
                   BasedOn="{StaticResource ContributionCellStyle}">
                <Setter Property="Background" Value="{ThemeResource ContributionLevel3Brush}" />
            </Style>
            <Style x:Key="ContributionLevel4Style" TargetType="local:ContributionDayCell"
                   BasedOn="{StaticResource ContributionCellStyle}">
                <Setter Property="Background" Value="{ThemeResource ContributionLevel4Brush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Spacing="4" Padding="2">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Contributions" Style="{StaticResource BodyStrongTextBlockStyle}"
                       AutomationProperties.HeadingLevel="Level2" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                       AutomationProperties.AutomationId="ContributionSummary"
                       AutomationProperties.Name="{x:Bind ViewModel.AccessibleSummary, Mode=OneWay}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <StackPanel Spacing="4" Visibility="{x:Bind local:ContributionHeatmap.Visible(ViewModel.HasDays), Mode=OneWay}">
            <Grid x:Name="CalendarGrid" Height="56" SizeChanged="CalendarGrid_SizeChanged"
                  PointerPressed="CalendarGrid_PointerPressed" Background="{ThemeResource SubtleFillColorTransparentBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="SelectionOutline" BorderThickness="1" CornerRadius="1"
                        BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" IsHitTestVisible="False"
                        AutomationProperties.AccessibilityView="Raw" Visibility="Collapsed" />
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.Range, Mode=OneWay}"
                           AutomationProperties.AutomationId="ContributionRange"
                           AutomationProperties.Name="{x:Bind ViewModel.RangeDescription, Mode=OneWay}"
                           ToolTipService.ToolTip="{x:Bind ViewModel.RangeDescription, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                            AutomationProperties.AccessibilityView="Raw"
                            ToolTipService.ToolTip="GitHub's five contribution levels, from none to highest. Exact counts are available for every day.">
                    <TextBlock Text="Less" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Width="7" Height="7" Background="{ThemeResource ContributionLevel0Brush}" CornerRadius="1" />
                    <Border Width="7" Height="7" Background="{ThemeResource ContributionLevel1Brush}" CornerRadius="1" />
                    <Border Width="7" Height="7" Background="{ThemeResource ContributionLevel2Brush}" CornerRadius="1" />
                    <Border Width="7" Height="7" Background="{ThemeResource ContributionLevel3Brush}" CornerRadius="1" />
                    <Border Width="7" Height="7" Background="{ThemeResource ContributionLevel4Brush}" CornerRadius="1" />
                    <TextBlock Text="More" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="SelectedDayText" Text="{x:Bind ViewModel.SelectedDayDescription, Mode=OneWay}"
                       AutomationProperties.AutomationId="ContributionSelectedDay"
                       AutomationProperties.LiveSetting="Polite"
                       Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                       ToolTipService.ToolTip="{x:Bind ViewModel.SelectedDayDescription, Mode=OneWay}" />
        </StackPanel>
        <TextBlock Text="{x:Bind Status, Mode=OneWay}"
                   AutomationProperties.AutomationId="ContributionStatus"
                   Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                   ToolTipService.ToolTip="{x:Bind Status, Mode=OneWay}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</UserControl>
