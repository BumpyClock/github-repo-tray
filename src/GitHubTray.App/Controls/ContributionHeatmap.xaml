<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GitHubTray_App.Controls.ContributionHeatmap"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GitHubTray_App.Controls"
    IsTabStop="True" UseSystemFocusVisuals="True"
    Loaded="Heatmap_Loaded" Unloaded="Heatmap_Unloaded"
    AutomationProperties.Name="{x:Bind ViewModel.AccessibleSummary, Mode=OneWay}"
    AutomationProperties.HelpText="Use Up and Down for the previous or next day, Left and Right for the previous or next week, Home for the first day, and End for the last day. Change cell size in Preferences.">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ContributionLevel0Brush" Color="{ThemeResource SolidBackgroundFillColorTertiary}" Opacity="0.5" />
                    <SolidColorBrush x:Key="ContributionEmptyStrokeBrush" Color="{ThemeResource ControlStrongStrokeColorDefault}" Opacity="0.4" />
                    <SolidColorBrush x:Key="ContributionSkeletonBrush" Color="{ThemeResource ControlStrongFillColorDefault}" Opacity="0.3" />
                    <SolidColorBrush x:Key="ContributionLevel1Brush" Color="#BCDFC2" />
                    <SolidColorBrush x:Key="ContributionLevel2Brush" Color="#75BE89" />
                    <SolidColorBrush x:Key="ContributionLevel3Brush" Color="#388654" />
                    <SolidColorBrush x:Key="ContributionLevel4Brush" Color="#185C37" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ContributionLevel0Brush" Color="{ThemeResource SolidBackgroundFillColorTertiary}" Opacity="0.5" />
                    <SolidColorBrush x:Key="ContributionEmptyStrokeBrush" Color="{ThemeResource ControlStrongStrokeColorDefault}" Opacity="0.4" />
                    <SolidColorBrush x:Key="ContributionSkeletonBrush" Color="{ThemeResource ControlStrongFillColorDefault}" Opacity="0.3" />
                    <SolidColorBrush x:Key="ContributionLevel1Brush" Color="#244D34" />
                    <SolidColorBrush x:Key="ContributionLevel2Brush" Color="#327448" />
                    <SolidColorBrush x:Key="ContributionLevel3Brush" Color="#4B9E61" />
                    <SolidColorBrush x:Key="ContributionLevel4Brush" Color="#8CCF99" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ContributionLevel0Brush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ContributionEmptyStrokeBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="ContributionSkeletonBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="ContributionLevel1Brush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="ContributionLevel2Brush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="ContributionLevel3Brush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ContributionLevel4Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="ContributionCellStyle" TargetType="local:ContributionDayCell">
                <Setter Property="Margin" Value="0.5" />
                <Setter Property="BorderThickness" Value="0.5" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:ContributionDayCell">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ContributionLevel0Style" TargetType="local:ContributionDayCell" BasedOn="{StaticResource ContributionCellStyle}">
                <Setter Property="Background" Value="{ThemeResource ContributionLevel0Brush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ContributionEmptyStrokeBrush}" />
            </Style>
            <Style x:Key="ContributionLevel1Style" TargetType="local:ContributionDayCell" BasedOn="{StaticResource ContributionCellStyle}">
                <Setter Property="Background" Value="{ThemeResource ContributionLevel1Brush}" />
            </Style>
            <Style x:Key="ContributionLevel2Style" TargetType="local:ContributionDayCell" BasedOn="{StaticResource ContributionCellStyle}">
                <Setter Property="Background" Value="{ThemeResource ContributionLevel2Brush}" />
            </Style>
            <Style x:Key="ContributionLevel3Style" TargetType="local:ContributionDayCell" BasedOn="{StaticResource ContributionCellStyle}">
                <Setter Property="Background" Value="{ThemeResource ContributionLevel3Brush}" />
            </Style>
            <Style x:Key="ContributionLevel4Style" TargetType="local:ContributionDayCell" BasedOn="{StaticResource ContributionCellStyle}">
                <Setter Property="Background" Value="{ThemeResource ContributionLevel4Brush}" />
            </Style>
            <Style x:Key="ContributionSkeletonCellStyle" TargetType="Border">
                <Setter Property="Margin" Value="0.5" />
                <Setter Property="CornerRadius" Value="1" />
                <Setter Property="Background" Value="{ThemeResource ContributionSkeletonBrush}" />
                <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Spacing="4" Padding="2">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="Contributions" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                       AutomationProperties.AutomationId="ContributionSummary"
                       AutomationProperties.Name="{x:Bind ViewModel.AccessibleSummary, Mode=OneWay}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <Grid x:Name="GraphContainer" Margin="0,4,0,0">
                <Grid x:Name="PlotOverlay" Margin="8,8,8,0">
                    <ScrollViewer x:Name="PlotScroll" Padding="0,0,0,12" IsTabStop="False" UseLayoutRounding="True"
                                  HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                                  HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                                  IsHorizontalScrollChainingEnabled="False" IsVerticalScrollChainingEnabled="False"
                                  IsZoomChainingEnabled="False" ZoomMode="Disabled"
                                  ViewChanged="PlotScroll_ViewChanged" SizeChanged="PlotScroll_SizeChanged"
                                  AutomationProperties.AutomationId="ContributionViewport" AutomationProperties.Name="Contribution calendar viewport">
                        <Grid x:Name="CalendarGrid" Height="140" HorizontalAlignment="Left" VerticalAlignment="Center" UseLayoutRounding="True"
                              Tapped="CalendarGrid_Tapped" Background="{ThemeResource SubtleFillColorTransparentBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20" /><RowDefinition Height="20" /><RowDefinition Height="20" />
                                <RowDefinition Height="20" /><RowDefinition Height="20" /><RowDefinition Height="20" /><RowDefinition Height="20" />
                            </Grid.RowDefinitions>
                            <Border x:Name="SelectionOutline" BorderThickness="1" CornerRadius="1"
                                    BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" IsHitTestVisible="False"
                                    AutomationProperties.AccessibilityView="Raw" Visibility="Collapsed" />
                        </Grid>
                    </ScrollViewer>
                    <TextBlock x:Name="GraphPlaceholder" Text="Contributions unavailable" Margin="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"
                               Visibility="Collapsed" AutomationProperties.AutomationId="ContributionPlaceholder" />
                </Grid>
            <!-- Keep the live-region peer without reserving a visible detail row. -->
            <TextBlock x:Name="SelectedDayText" Text="{x:Bind ViewModel.SelectedDayDescription, Mode=OneWay}" Height="22"
                       Opacity="0" IsHitTestVisible="False"
                       AutomationProperties.AutomationId="ContributionSelectedDay" AutomationProperties.LiveSetting="Polite"
                       Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
        </Grid>
        <TextBlock Text="{x:Bind Status, Mode=OneWay}"
                   Visibility="{x:Bind local:ContributionHeatmap.FeedbackVisibility(IsLoading, ViewModel.HasDays, HasError), Mode=OneWay}"
                   AutomationProperties.AutomationId="ContributionStatus" AutomationProperties.LiveSetting="Polite"
                   Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                   ToolTipService.ToolTip="{x:Bind Status, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</UserControl>
